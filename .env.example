# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App Configuration
NEXT_PUBLIC_APP_NAME=Mudmy
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Omise Configuration
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxxxxxxx
OMISE_API_VERSION=2019-05-29
OMISE_WEBHOOK_SECRET=your_omise_webhook_secret

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
